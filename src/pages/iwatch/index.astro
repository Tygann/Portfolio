---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Device from "../../components/Device.astro";
const page = {
  "brand": "iwatch",
  "title": "iWatch · Movie and TV Show Tracker",
  "description": "Keep the movies and TV shows you’re watching, finished, and planning to watch in one place with iWatch for iPhone.",
  "canonical": "https://tylerkeegan.com/iwatch/",
  "bodyClass": "theme-iwatch app-site",
  "documentPage": false,
  "footerClass": "footer app-footer",
  "footerLinks": [
    {
      "href": "/iwatch/support/",
      "label": "Support"
    },
    {
      "href": "/iwatch/privacy/",
      "label": "Privacy"
    },
    {
      "href": "/",
      "label": "Portfolio"
    }
  ],
  "footerSeparators": false
};
---
<SiteLayout {...page}>
<div class="hero-wrap">
      <section class="hero hero-product">
        <div class="hero-copy">
          <span class="tile tile-iwatch"><img fetchpriority="high" width="88" height="88" decoding="async" src="/icons/iwatch-web.png" alt="iWatch app icon"></span>
          <h1>Every show.<br>One list.</h1>
          <p class="lede">iWatch tracks the movies and TV shows you’re watching, the ones you’ve finished, and the ones you keep meaning to start.</p>
          <div class="actions">
            <a class="button testflight-button" href="https://testflight.apple.com/join/r6MFxreq">Join the beta on TestFlight</a>
          </div>
          <p class="meta">In beta for iPhone.</p>
        </div>
        <Device light="/iwatch/screens/shows-light.webp" dark="/iwatch/screens/shows-dark.webp" alt="iWatch Shows screen with Continue Watching and Coming Up" hero />
      </section>
    </div>

    <div id="features" class="features-chapter">
      <section class="feature feature-flip">
        <div class="feature-copy">
          <p class="eyebrow">Up next</p>
          <h2>Pick up right where you left off.</h2>
          <p>The next episode of everything you’re watching, in one place.</p>
        </div>
        <Device light="/iwatch/screens/episode-progress-light.webp" dark="/iwatch/screens/episode-progress-dark.webp" alt="Episode progress for Dark Matter in iWatch" />
      </section>

      <section class="feature">
        <div class="feature-copy">
          <p class="eyebrow">Watchlist</p>
          <h2>For the someday pile.</h2>
          <p>Save the film a friend swore by, and find it again when it’s finally movie night.</p>
        </div>
        <Device light="/iwatch/screens/movie-watchlist-light.webp" dark="/iwatch/screens/movie-watchlist-dark.webp" alt="iWatch Movies watchlist" />
      </section>

      <section class="feature feature-flip">
        <div class="feature-copy">
          <p class="eyebrow">Discover</p>
          <h2>Find your next favorite.</h2>
          <p>Search movies and TV shows, explore trending titles, and browse by streaming service.</p>
        </div>
        <Device light="/iwatch/screens/search-light.webp" dark="/iwatch/screens/search-dark.webp" alt="Search for movies and TV shows in iWatch" />
      </section>

      <section class="feature">
        <div class="feature-copy">
          <p class="eyebrow">Details</p>
          <h2>Get to know what’s next.</h2>
          <p>Explore ratings, cast, and where to watch. Mark a movie watched when the credits roll.</p>
        </div>
        <Device light="/iwatch/screens/movie-details-light.webp" dark="/iwatch/screens/movie-details-dark.webp" alt="Movie details and viewing services for Blade Runner 2049 in iWatch" />
      </section>
    </div>

    <section class="contact">
      <h2>Find your next movie night.</h2>
      <p class="lede">Keep what you’re watching and what’s next in one place.</p>
      <div class="actions">
        <a class="button testflight-button" href="https://testflight.apple.com/join/r6MFxreq">Join the beta on TestFlight</a>
      </div>
    </section>
</SiteLayout>
