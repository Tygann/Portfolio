---
import SiteLayout from "../../../layouts/SiteLayout.astro";
const page = {
  "brand": "iwatch",
  "title": "Support · iWatch",
  "description": "Get help with the iWatch movie and TV show tracker.",
  "canonical": "https://tylerkeegan.com/iwatch/support/",
  "bodyClass": "theme-iwatch",
  "documentPage": true,
  "footerClass": "footer app-footer",
  "footerLinks": [
    {
      "href": "/iwatch/support/",
      "aria-current": "page",
      "label": "Support"
    },
    {
      "href": "/iwatch/privacy/",
      "label": "Privacy"
    },
    {
      "href": "/",
      "label": "Portfolio"
    }
  ],
  "footerSeparators": false
};
---
<SiteLayout {...page}>
<div class="hero-wrap"><section class="hero document-hero">
      <span class="tile"><img fetchpriority="high" width="88" height="88" decoding="async" src="/icons/iwatch-web.png" alt="iWatch app icon"></span>
      <h1>How can we help?</h1>
    </section></div>
    <article class="document-copy" aria-label="Support">
      <p>Have a question about iWatch or something that is not working? Email <a href="mailto:Tyler@Keegan.me">Tyler@Keegan.me</a> with a brief description of what happened.</p>
      <h2>Reporting a problem</h2>
      <p>Include your iWatch version, iPhone model, iOS version, and the steps that led to the issue. A screenshot can help explain what you see.</p>
      <h2>TestFlight feedback</h2>
      <p>You can also send feedback through TestFlight. Open TestFlight, select iWatch, and choose Send Beta Feedback.</p>
      <h2>Protect your privacy</h2>
      <p>Do not send passwords, access tokens, or other private credentials. Hide personal information before sharing screenshots. Read the <a href="/iwatch/privacy/">Privacy Policy</a> for details about your library, iCloud, optional Trakt sync, and deletion controls.</p>
    </article>
</SiteLayout>
