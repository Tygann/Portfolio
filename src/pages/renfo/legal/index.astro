---
import SiteLayout from "../../../layouts/SiteLayout.astro";
const page = {
  "brand": "renfo",
  "title": "Legal · Renfo",
  "description": "Trademark and asset credits for Renfo.",
  "canonical": "https://renfo.app/legal",
  "bodyClass": "theme-renfo",
  "documentPage": true,
  "footerClass": "footer app-footer",
  "footerLinks": [
    {
      "href": "/renfo/support/",
      "label": "Support"
    },
    {
      "href": "/renfo/privacy/",
      "label": "Privacy"
    },
    {
      "href": "https://tylerkeegan.com/",
      "label": "Portfolio"
    },
    {
      "href": "/renfo/legal/",
      "aria-current": "page",
      "label": "Legal"
    }
  ],
  "footerSeparators": false
};
---
<SiteLayout {...page}>
<div class="hero-wrap"><section class="hero document-hero">
      <span class="tile"><img fetchpriority="high" width="88" height="88" decoding="async" src="/icons/renfo-web.png" alt="Renfo app icon"></span>
      <h1>Legal</h1><p class="meta">Trademark and asset credits</p>
    </section></div>
    <article class="document-copy" aria-label="Legal credits">
      <h2>Apple trademarks</h2>
      <p>Apple, the Apple logo, and iPhone are trademarks of Apple Inc., registered in the U.S. and other countries. App Store is a service mark of Apple Inc.</p>
    </article>
</SiteLayout>
