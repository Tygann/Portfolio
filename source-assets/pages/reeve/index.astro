---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Device from "../../components/Device.astro";
const page = {
  "brand": "reeve",
  "title": "Reeve Money · Design and Development by Tyler Keegan",
  "description": "Tyler Keegan contributed UI design and front-end development to Reeve Money, an app by Peach Byte Labs.",
  "canonical": "https://tylerkeegan.com/reeve/",
  "bodyClass": "theme-reeve app-site",
  "documentPage": false,
  "footerClass": "footer app-footer",
  "footerLinks": [
    {
      "href": "mailto:Tyler@Keegan.me",
      "label": "Contact"
    },
    {
      "href": "/",
      "label": "Portfolio"
    }
  ],
  "footerSeparators": false
};
---
<SiteLayout {...page}>
<div class="hero-wrap">
      <section class="hero hero-product">
        <div class="hero-copy">
          <span class="tile tile-reeve"><img fetchpriority="high" width="88" height="88" decoding="async" src="/icons/reeve-web.png" alt="Reeve Money app icon"></span>
          <h1>Reeve Money</h1>
          <p class="lede">A personal finance app for iPhone and iPad. Contributed UI design and front-end development to Reeve Money, an app by Peach Byte Labs.</p>
          <ul class="role">
            <li>UI design</li>
            <li>Front-end development</li>
          </ul>
          <div class="actions">
            <a class="button" href="https://reevemoney.com">Visit reevemoney.com</a>
          </div>
        </div>
        <Device />
      </section>
    </div>

    <section class="contact">
      <h2>More from Tyler.</h2>
      <p class="lede">See the other apps I’ve worked on, and a few of my own.</p>
      <div class="actions">
        <a class="button" href="/">See all projects</a>
      </div>
    </section>
</SiteLayout>
