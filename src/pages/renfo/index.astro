---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Device from "../../components/Device.astro";
const page = {
  "brand": "renfo",
  "title": "Renfo · Discover Renaissance Festivals",
  "description": "Discover renaissance festivals worldwide with Renfo. Explore the map, check dates and hours, and save your favorites.",
  "canonical": "https://renfo.app/",
  "bodyClass": "theme-renfo app-site",
  "documentPage": false,
  "footerClass": "footer app-footer",
  "footerLinks": [
    {
      "href": "https://renfo.app/support",
      "label": "Support"
    },
    {
      "href": "https://renfo.app/privacy",
      "label": "Privacy"
    },
    {
      "href": "/renfo/legal/",
      "label": "Legal"
    },
    {
      "href": "https://tylerkeegan.com/",
      "label": "Portfolio"
    },
    {
      "href": "https://testflight.apple.com/join/WnvOF5Jg",
      "label": "Join the beta"
    }
  ],
  "footerSeparators": false,
  "appStoreId": "app-id=6502414968"
};
---
<SiteLayout {...page}>
<div class="hero-wrap">
      <section class="hero hero-product">
        <div class="hero-copy">
          <span class="tile tile-renfo"><img fetchpriority="high" width="88" height="88" decoding="async" src="/icons/renfo-web.png" alt="Renfo app icon"></span>
          <h1>Your next<br>faire awaits.</h1>
          <p class="lede">Discover renaissance festivals around the world. Check dates, explore the map, and save your favorites.</p>
          <div class="actions">
            <a class="store-badge" href="https://apps.apple.com/us/app/renfo/id6502414968?itscg=30200&amp;itsct=apps_box_badge&amp;mttnsubad=6502414968"><picture><source media="(prefers-color-scheme: dark)" srcset="https://toolbox.marketingtools.apple.com/api/v2/badges/download-on-the-app-store/white/en-us?releaseDate=1727308800"><img width="120" height="40" decoding="async" src="https://toolbox.marketingtools.apple.com/api/v2/badges/download-on-the-app-store/black/en-us?releaseDate=1727308800" alt="Download on the App Store"></picture></a>
            <a class="link" href="https://web.renfo.app/">Open web app<span class="link-chevron" aria-hidden="true"></span></a>
          </div>
          <p class="meta">Available for iPhone and on the web.</p>
        </div>
        <Device light="/renfo/screens/festival-map-light.webp" dark="/renfo/screens/festival-map-dark.webp" alt="Renfo’s map of North America with a crown pin on every renaissance festival, and the Festivals sheet below" hero />
      </section>
    </div>

    <div id="features" class="features-chapter">
      <section class="feature feature-flip">
        <div class="feature-copy">
          <p class="eyebrow">Browse</p>
          <h2>Find a festival.</h2>
          <p>Explore the map and directory. Search for your next faire and save your favorites.</p>
        </div>
        <Device light="/renfo/screens/festival-directory-light.webp" dark="/renfo/screens/festival-directory-dark.webp" alt="An alphabetical list of renaissance festivals in Renfo" />
      </section>

      <section class="feature">
        <div class="feature-copy">
          <p class="eyebrow">Countdown</p>
          <h2>Open now. Coming soon.</h2>
          <p>See what&#8217;s open now and what&#8217;s coming up. Count down the days to your next faire.</p>
        </div>
        <Device light="/renfo/screens/festival-sorting-light.webp" dark="/renfo/screens/festival-sorting-dark.webp" alt="Renfo’s Group By and Sort By menu over lists of active and upcoming festivals" />
      </section>

      <section class="feature feature-flip">
        <div class="feature-copy">
          <p class="eyebrow">Festivals</p>
          <h2>Plan your visit.</h2>
          <p>Check dates, hours, weather, and directions. Call or email the faire with one tap.</p>
        </div>
        <Device light="/renfo/screens/festival-details-light.webp" dark="/renfo/screens/festival-details-dark.webp" alt="The Texas Renaissance Festival page in Renfo, with its dates, hours, weather and address" />
      </section>

      <section class="feature">
        <div class="feature-copy">
          <p class="eyebrow">Badges</p>
          <h2>A badge for every faire.</h2>
          <p>Check in at a festival to earn its badge, and add a laurel for every year you go back.</p>
        </div>
        <Device light="/renfo/screens/festival-badge-light.webp" dark="/renfo/screens/festival-badge-dark.webp" alt="The Texas Renaissance Festival badge in Renfo, with a laurel for each of six years attended" />
      </section>
    </div>

    <section class="contact">
      <h2>Your next adventure starts here.</h2>
      <p class="lede">Find your faire, plan your visit, and make it a tradition.</p>
      <div class="actions">
        <a class="button" href="https://apps.apple.com/us/app/renfo/id6502414968">Get Renfo for iPhone</a>
        <a class="link" href="https://web.renfo.app/">Open web app</a>
      </div>
    </section>
</SiteLayout>
