---
import { assetUrl } from '../data/assets.js';
import appearanceInit from '../scripts/appearance-init.js?raw';
const { brand, title, description, canonical, appStoreId, noindex = false } = Astro.props;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content={brand.themeColors[0]} media="(prefers-color-scheme: light)" data-theme-color="light" />
<meta name="theme-color" content={brand.themeColors[1]} media="(prefers-color-scheme: dark)" data-theme-color="dark" />
{noindex && <meta name="robots" content="noindex" />}
<script is:inline set:html={appearanceInit}></script>
<title>{title}</title>
<meta name="description" content={description} />
{appStoreId && <meta name="apple-itunes-app" content={appStoreId} />}
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={brand.siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={brand.socialImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={brand.socialAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={brand.socialImage} />
<meta name="twitter:image:alt" content={brand.socialAlt} />
<link rel="icon" type="image/png" href={brand.icon} />
<link rel="stylesheet" href={assetUrl('styles.css')} />
