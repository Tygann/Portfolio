---
import SiteLayout from "../../../layouts/SiteLayout.astro";
const page = {
  "brand": "homestead",
  "title": "Legal · Homestead",
  "description": "Affiliation information for Homestead.",
  "canonical": "https://homesteadcontrol.com/legal",
  "bodyClass": "theme-homestead",
  "documentPage": true,
  "footerClass": "footer app-footer",
  "footerLinks": [
    {
      "href": "/homestead/support/",
      "label": "Support"
    },
    {
      "href": "/homestead/privacy/",
      "label": "Privacy"
    },
    {
      "href": "https://tylerkeegan.com/",
      "label": "Portfolio"
    },
    {
      "href": "https://tylerkeegan.com/homestead/legal/",
      "aria-current": "page",
      "label": "Legal"
    }
  ],
  "footerSeparators": false
};
---
<SiteLayout {...page}>
<div class="hero-wrap"><section class="hero document-hero">
      <span class="tile"><img fetchpriority="high" width="88" height="88" decoding="async" src="/icons/homestead-web.png" alt="Homestead app icon"></span>
      <h1>Legal</h1><p class="meta">Affiliation information</p>
    </section></div>
    <article class="document-copy" aria-label="Legal information">
      <h2>Independent Home Assistant client</h2>
      <p>Homestead is an independent third-party client and is not affiliated with or endorsed by the Home Assistant project.</p>
    </article>
</SiteLayout>
