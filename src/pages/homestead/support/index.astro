---
import SiteLayout from "../../../layouts/SiteLayout.astro";
const page = {
  "brand": "homestead",
  "title": "Support · Homestead",
  "description": "Support for Homestead, a native Home Assistant app for iPhone and iPad.",
  "canonical": "https://homesteadcontrol.com/support",
  "bodyClass": "theme-homestead",
  "documentPage": true,
  "footerClass": "footer",
  "footerLinks": [
    {
      "href": "/homestead/support/",
      "aria-current": "page",
      "label": "Support"
    },
    {
      "href": "/homestead/privacy/",
      "label": "Privacy"
    },
    {
      "href": "https://tylerkeegan.com/",
      "label": "Portfolio"
    },
    {
      "href": "https://tylerkeegan.com/homestead/legal/",
      "label": "Legal"
    }
  ],
  "footerSeparators": true
};
---
<SiteLayout {...page}>
<div class="hero-wrap"><section class="hero document-hero">
      <span class="tile"><img fetchpriority="high" width="88" height="88" decoding="async" src="/icons/homestead-web.png" alt="Homestead app icon"></span>
      <h1>How can we help?</h1>
    </section></div>
    <article class="document-copy" aria-label="Support">
<p>For help with Homestead, <a href="mailto:support@homesteadcontrol.com">email support@homesteadcontrol.com</a> with a brief description of what happened and the app version you’re using.</p>
<h2>Before contacting support</h2>
<ul><li>Confirm your Home Assistant server is reachable from Safari.</li><li>In Homestead, open Settings and review the connection status.</li><li>For purchase issues, try Restore Purchases from the Homestead+ screen.</li></ul>
<h2>Protect your privacy</h2>
<p>Never send Home Assistant access tokens, passwords, or other private credentials. Homestead includes privacy-safe diagnostics that can be copied from Settings when useful.</p>
    </article>
</SiteLayout>
