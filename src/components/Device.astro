---
const { light, dark, alt = '', hero = false } = Astro.props;
// Delivery variants exist after a production build; dev serves the originals.
const srcset = path => import.meta.env.DEV ? path : `${path.replace('.webp', '-360w.webp')} 360w, ${path.replace('.webp', '-720w.webp')} 720w, ${path} 1206w`;
const sizes = '(max-width: 384px) 69.68vw, 268px';
---
<div class="device"><div class="device-screen">
  {light ? <picture>
    <source media="(prefers-color-scheme: dark)" srcset={srcset(dark)} sizes={sizes} />
    <img width="1206" height="2622" decoding="async" src={light} srcset={srcset(light)} sizes={sizes} alt={alt}
      loading={hero ? undefined : 'lazy'} fetchpriority={hero ? 'high' : undefined} />
  </picture> : <span class="device-placeholder">Screenshot coming soon</span>}
</div></div>
